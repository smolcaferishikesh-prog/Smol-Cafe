{
  "name": "smol-cafe",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@smol-cafe/web",
    "build": "npm run build --workspace=@smol-cafe/web && node -e \"try{require('fs').cpSync('apps/web/.next','.next',{recursive:true})}catch(e){}\"",
    "start": "npm run start --workspace=@smol-cafe/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@smol-cafe/db",
    "test:invariants": "npm run test:invariants --workspace=@smol-cafe/db",
    "test:refunds": "npm run test:refunds --workspace=@smol-cafe/db",
    "test:rbac": "npm run test:rbac --workspace=@smol-cafe/db",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:types": "npm run db:types --workspace=@smol-cafe/db",
    "db:diff": "npm run db:diff --workspace=@smol-cafe/db",
    "db:push": "npm run db:push --workspace=@smol-cafe/db",
    "db:status": "npm run db:status --workspace=@smol-cafe/db",
    "db:seed:dry": "npm run db:seed:dry --workspace=@smol-cafe/db",
    "db:seed:apply": "npm run db:seed:apply --workspace=@smol-cafe/db"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.7",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
